# Copiar este archivo a .env para desarrollo local (docker-compose.yml en
# la raíz del repo ya crea la base con estas mismas credenciales).

DEBUG=True
# Generar una propia (50+ caracteres), por ejemplo con:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=<clave-secreta>
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# postgres://<usuario>:<password>@<host>:<puerto>/<nombre_db>
# Puerto 5433 (no 5432): ver comentario en docker-compose.yml sobre el
# PostgreSQL nativo que ya pueda estar corriendo en esta máquina.
DATABASE_URL=postgres://<usuario>:<password>@localhost:5433/eoq_db

CORS_ALLOWED_ORIGINS=http://localhost:5173
