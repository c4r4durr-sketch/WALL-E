# Copiar este archivo a .env para desarrollo local y completar los valores
# entre < >. DJANGO_SECRET_KEY y DATABASE_URL son obligatorias: sin ellas
# Django no arranca.

DEBUG=True
# Generar una propia (50+ caracteres), por ejemplo con:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=AKG8LBpCALDQlaTAJh_vfnhLi5YAYEE55RIDRorYZ6oik-4EQRs25BZzH0eK4jydYXQ
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# postgres://<usuario>:<password>@<host>:<puerto>/<nombre_db>
# Puerto 5433 (no 5432): ver comentario en docker-compose.yml sobre el
# PostgreSQL nativo que ya pueda estar corriendo en esta máquina.
DATABASE_URL=postgres://<usuario>:<password>@localhost:5433/eoq_db

CORS_ALLOWED_ORIGINS=http://localhost:5173

# Opcional: contraseña de las cuentas de demo que crea
# "manage.py cargar_demo --usuarios" (también se puede pasar solo en la
# terminal, sin guardarla acá).
# DEMO_PASSWORD=<contraseña-de-demo>
